#!/bin/bash
# xray-users - Manage XRay VLESS REALITY users
# Usage: xray-users <command> [args]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Load configuration
load_config() {
    if [[ -f "$REPO_DIR/.env" ]]; then
        source "$REPO_DIR/.env"
    fi

    USERS_FILE="$REPO_DIR/users.json"
    SERVERS_FILE="$REPO_DIR/servers.json"
    CONFIG_PATH="${CONFIG_PATH:-/opt/xray/config.json}"

    if [[ ! -f "$SERVERS_FILE" ]]; then
        echo -e "${RED}Error: servers.json not found. Run deploy.sh first.${NC}"
        exit 1
    fi
}

# Initialize users file if it doesn't exist
init_users_file() {
    if [[ ! -f "$USERS_FILE" ]]; then
        echo '{}' > "$USERS_FILE"
    fi
}

# Get list of SSH hosts from servers.json
get_ssh_hosts() {
    jq -r '.[].ssh' "$SERVERS_FILE"
}

# Get server config
get_server_config() {
    local host="${1:-$(jq -r '.[0].ssh' "$SERVERS_FILE")}"
    ssh "$host" "cat $CONFIG_PATH" 2>/dev/null
}

# Update server config
update_server_config() {
    local config="$1"
    local host="$2"
    echo "$config" | ssh "$host" "cat > $CONFIG_PATH"
}

# Validate and restart XRay container
restart_xray() {
    local host="$1"
    echo -n "Validating config on $host... "
    if ssh "$host" "cd /opt/xray && docker compose exec -T xray xray -test -c /etc/xray/config.json" >/dev/null 2>&1; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FAILED${NC}"
        echo -e "${RED}Config validation failed on $host, aborting restart${NC}"
        return 1
    fi
    echo -n "Restarting on $host... "
    ssh "$host" "cd /opt/xray && docker compose restart xray" >/dev/null
    echo -e "${GREEN}done${NC}"
}

# Get all UUIDs from first server
get_server_uuids() {
    local host
    host=$(jq -r '.[0].ssh' "$SERVERS_FILE")
    get_server_config "$host" | jq -r '[.inbounds[].settings.clients[].id] | unique[]'
}

# Get user name by UUID
get_user_name() {
    local uuid="$1"
    jq -r --arg uuid "$uuid" '.[$uuid] // "unnamed"' "$USERS_FILE"
}

# Set user name
set_user_name() {
    local uuid="$1"
    local name="$2"
    local tmp
    tmp=$(mktemp)
    jq --arg uuid "$uuid" --arg name "$name" '.[$uuid] = $name' "$USERS_FILE" > "$tmp"
    mv "$tmp" "$USERS_FILE"
}

# Remove user name
remove_user_name() {
    local uuid="$1"
    local tmp
    tmp=$(mktemp)
    jq --arg uuid "$uuid" 'del(.[$uuid])' "$USERS_FILE" > "$tmp"
    mv "$tmp" "$USERS_FILE"
}

# Find UUID by name
find_uuid_by_name() {
    local name="$1"
    jq -r --arg name "$name" 'to_entries[] | select(.value == $name) | .key' "$USERS_FILE" | head -1
}

# Resolve UUID (accepts UUID or name)
resolve_uuid() {
    local input="$1"
    if [[ "$input" =~ ^[0-9a-fA-F-]{36}$ ]]; then
        echo "$input"
    else
        find_uuid_by_name "$input"
    fi
}

# Generate VLESS share URLs for all servers
generate_url() {
    local uuid="$1"
    local name="${2:-$(get_user_name "$uuid")}"
    local encoded_name
    encoded_name=$(echo -n "$name" | jq -sRr @uri)

    jq -r --arg uuid "$uuid" --arg name "$encoded_name" \
        --arg fp "${FINGERPRINT:-chrome}" --arg flow "${FLOW:-xtls-rprx-vision}" \
        '.[] |
        "# \(.name) — XHTTP (port 443):\nvless://\($uuid)@\(.host):443?encryption=none&security=reality&sni=\(.xhttp_sni)&fp=\($fp)&pbk=\(.public_key)&sid=\(.short_id)&type=xhttp&path=%2F\(.xhttp_path)#\($name)-\(.name)-xhttp\n\n# \(.name) — TCP+vision (port 8443):\nvless://\($uuid)@\(.host):8443?encryption=none&flow=\($flow)&security=reality&sni=\(.sni)&fp=\($fp)&pbk=\(.public_key)&sid=\(.short_id)&type=tcp#\($name)-\(.name)-tcp"
        ' "$SERVERS_FILE"
}

# Command: list
cmd_list() {
    init_users_file
    echo -e "${BLUE}XRay VLESS Users:${NC}"
    echo "─────────────────────────────────────────────────────"

    local uuids count=0
    uuids=$(get_server_uuids)

    while IFS= read -r uuid; do
        [[ -z "$uuid" ]] && continue
        local name
        name=$(get_user_name "$uuid")
        count=$((count + 1))
        printf "${GREEN}%d.${NC} %-20s ${YELLOW}%s${NC}\n" "$count" "$name" "$uuid"
    done <<< "$uuids"

    echo "─────────────────────────────────────────────────────"
    echo -e "Total: ${GREEN}$count${NC} users on ${GREEN}$(jq 'length' "$SERVERS_FILE")${NC} servers"
}

# Command: add
cmd_add() {
    local name="${1:-}"

    if [[ -z "$name" ]]; then
        echo -e "${RED}Error: Name required${NC}"
        echo "Usage: xray-users add <name>"
        exit 1
    fi

    init_users_file

    local uuid
    uuid=$(uuidgen | tr '[:upper:]' '[:lower:]')

    echo -e "${BLUE}Adding new user: ${GREEN}$name${NC}"
    echo -e "UUID: ${YELLOW}$uuid${NC}"

    # Add user to all servers
    while IFS= read -r host; do
        echo -e "${BLUE}Updating $host...${NC}"
        local config new_config
        config=$(get_server_config "$host")

        new_config=$(echo "$config" | jq --arg uuid "$uuid" --arg flow "${FLOW:-xtls-rprx-vision}" \
            '.inbounds |= map(
                if .streamSettings.network == "tcp" then
                    .settings.clients += [{"id": $uuid, "flow": $flow}]
                else
                    .settings.clients += [{"id": $uuid}]
                end
            )')

        update_server_config "$new_config" "$host"
        restart_xray "$host"
    done <<< "$(get_ssh_hosts)"

    set_user_name "$uuid" "$name"

    echo ""
    echo -e "${GREEN}Share URLs:${NC}"
    generate_url "$uuid" "$name"
    echo ""
}

# Command: remove
cmd_remove() {
    local input="${1:-}"

    if [[ -z "$input" ]]; then
        echo -e "${RED}Error: UUID or name required${NC}"
        echo "Usage: xray-users remove <uuid|name>"
        exit 1
    fi

    init_users_file

    local uuid
    uuid=$(resolve_uuid "$input")

    if [[ -z "$uuid" ]]; then
        echo -e "${RED}Error: User not found: $input${NC}"
        exit 1
    fi

    local name
    name=$(get_user_name "$uuid")

    echo -e "${YELLOW}Removing user: $name ($uuid)${NC}"
    read -p "Are you sure? [y/N] " confirm

    if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
        echo "Cancelled."
        exit 0
    fi

    # Remove from all servers
    while IFS= read -r host; do
        echo -e "${BLUE}Updating $host...${NC}"
        local config new_config
        config=$(get_server_config "$host")
        new_config=$(echo "$config" | jq --arg uuid "$uuid" \
            '.inbounds[].settings.clients |= map(select(.id != $uuid))')

        update_server_config "$new_config" "$host"
        restart_xray "$host"
    done <<< "$(get_ssh_hosts)"

    remove_user_name "$uuid"

    echo -e "${GREEN}User removed successfully${NC}"
}

# Command: url
cmd_url() {
    local input="${1:-}"

    if [[ -z "$input" ]]; then
        echo -e "${RED}Error: UUID or name required${NC}"
        echo "Usage: xray-users url <uuid|name>"
        exit 1
    fi

    init_users_file

    local uuid
    uuid=$(resolve_uuid "$input")

    if [[ -z "$uuid" ]]; then
        echo -e "${RED}Error: User not found: $input${NC}"
        exit 1
    fi

    generate_url "$uuid"
}

# Command: enroll-url — print bb-vpn:// URI for the bb-vpn .pkg flow.
# Distributed alongside the .pkg download link; the menu-bar app's
# CFBundleURLTypes handler turns the click into an inbox/ enrollment.
cmd_enroll_url() {
    local input="${1:-}"

    if [[ -z "$input" ]]; then
        echo -e "${RED}Error: UUID or name required${NC}" >&2
        echo "Usage: xray-users enroll-url <uuid|name>" >&2
        exit 1
    fi

    init_users_file

    local uuid
    uuid=$(resolve_uuid "$input")

    if [[ -z "$uuid" ]]; then
        echo -e "${RED}Error: User not found: $input${NC}" >&2
        exit 1
    fi

    echo "bb-vpn://enroll?uuid=${uuid}"
}

# Command: sync
cmd_sync() {
    init_users_file

    echo -e "${BLUE}Syncing with server...${NC}"

    local uuids count=0
    uuids=$(get_server_uuids)

    while IFS= read -r uuid; do
        [[ -z "$uuid" ]] && continue
        local name
        name=$(get_user_name "$uuid")

        if [[ "$name" == "unnamed" ]]; then
            echo -e "${YELLOW}Found unnamed user: $uuid${NC}"
            read -p "Enter name for this user (or press Enter to skip): " new_name
            if [[ -n "$new_name" ]]; then
                set_user_name "$uuid" "$new_name"
                echo -e "  Set name: ${GREEN}$new_name${NC}"
            fi
        fi
        count=$((count + 1))
    done <<< "$uuids"

    echo -e "${GREEN}Sync complete. $count users on server.${NC}"
}

# Command: help
cmd_help() {
    echo "xray-users - Manage XRay VLESS REALITY users"
    echo ""
    echo "Usage: xray-users <command> [args]"
    echo ""
    echo "Commands:"
    echo "  list              List all users"
    echo "  add <name>        Add new user to all servers"
    echo "  remove <id|name>  Remove user from all servers"
    echo "  url <id|name>     Generate share URLs for all servers"
    echo "  enroll-url <id|name>  Print bb-vpn://enroll URI for the .pkg flow"
    echo "  sync              Sync local names with server"
    echo "  help              Show this help"
    echo ""
    echo "Examples:"
    echo "  xray-users add \"Mom iPhone\""
    echo "  xray-users url \"Mom iPhone\""
    echo "  xray-users remove \"Mom iPhone\""
}

# Main
main() {
    load_config

    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        list)   cmd_list "$@" ;;
        add)    cmd_add "$@" ;;
        remove) cmd_remove "$@" ;;
        url)    cmd_url "$@" ;;
        enroll-url) cmd_enroll_url "$@" ;;
        sync)   cmd_sync "$@" ;;
        help|--help|-h) cmd_help ;;
        *)
            echo -e "${RED}Unknown command: $cmd${NC}"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
