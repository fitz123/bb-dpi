#!/bin/bash
#
# Generate sing-box client config package from VLESS URL or user name
#
# Usage:
#   ./scripts/generate-client-config <device-name|vless-url> [render-config-flags...]
#
# Render-config flags (passed through verbatim):
#   --with-corp-dns          Include corp DNS server (resolved via the VLESS exit)
#   --proto all|tcp-vision|xhttp
#

set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# Save CLI-provided values BEFORE sourcing .env. SINGBOX_OUTPUT / XRAY_OUTPUT
# are explicitly *script-call-site* knobs (used by throwaway-client data-path
# gates that must not clobber the live laptop configs); .env entries for them
# are silently ignored so an accidental `.env` setting can't redirect the
# `rm -f $XRAY_OUTPUT` below or hand a wrong path to render-config.
# `${VAR-}` preserves the empty-vs-unset distinction, but the downstream
# defaults treat them the same.
CLI_SINGBOX_OUTPUT="${SINGBOX_OUTPUT-}"
CLI_XRAY_OUTPUT="${XRAY_OUTPUT-}"

# Load environment (provides defaults)
if [[ -f "$PROJECT_DIR/.env" ]]; then
    source "$PROJECT_DIR/.env"
fi

# For the OUTPUT knobs, always restore — even an "unset CLI" wins over .env's
# attempt to set them. Otherwise `.env` could redirect render-config and the
# `rm -f` below to surprise paths.
SINGBOX_OUTPUT="$CLI_SINGBOX_OUTPUT"
XRAY_OUTPUT="$CLI_XRAY_OUTPUT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

usage() {
    echo "Usage: $0 <device-name|vless-url> [render-config-flags...]"
    echo ""
    echo "Examples:"
    echo "  $0 \"leo-mac\"                     # bare VLESS, no corp DNS"
    echo "  $0 \"leo-mac\" --with-corp-dns     # + corp DNS via VLESS exit"
    echo "  $0 \"leo-mac\" --proto tcp-vision  # TCP+vision only (skip xray)"
    echo "  $0 \"vless://uuid@host:port?...\""
    exit 1
}

[[ -z "$1" ]] && usage

INPUT="$1"
shift

# Forward all remaining args verbatim to render-config.
RENDER_FLAGS=("$@")

# Check if input is a VLESS URL or device name
if [[ "$INPUT" == vless://* ]]; then
    VLESS_URL="$INPUT"
else
    # `xray-users url` iterates ALL servers (no client_render filter, by
    # design — relay chains need synced UUIDs). Pick the first TCP URL whose
    # host belongs to a client-visible server, so package metadata (NAME,
    # HOST, SNI in the rendered README/banner) never leaks an upstream-only
    # server's identity.
    VLESS_URL=""
    while IFS= read -r url; do
        [[ -z "$url" ]] && continue
        url_host=$(echo "$url" | sed -n 's|vless://[^@]*@\([^:]*\):.*|\1|p')
        [[ -z "$url_host" ]] && continue
        if [[ "$(jq --arg h "$url_host" 'any(.[]; .host == $h and (.client_render != false))' "$PROJECT_DIR/servers.json")" == "true" ]]; then
            VLESS_URL="$url"
            break
        fi
    done < <("$SCRIPT_DIR/xray-users" url "$INPUT" 2>/dev/null | grep '^vless://' | grep 'type=tcp')
    if [[ -z "$VLESS_URL" ]]; then
        echo -e "${RED}Error: Could not get URL for device '$INPUT' (no client-visible server URLs available)${NC}"
        exit 1
    fi
fi

# Parse VLESS URL.
# `|| true` is needed because of `set -eo pipefail`: when an optional field
# (sni, name, port) is absent, the grep in the pipeline returns 1 and would
# abort the script before the `${FIELD:-default}` fallbacks a few lines down
# can apply. Required fields are validated explicitly below; if their parse
# returns empty the validation block exits with a clear error.
UUID=$(echo "$VLESS_URL" | sed -n 's|vless://\([^@]*\)@.*|\1|p')
HOST=$(echo "$VLESS_URL" | sed -n 's|vless://[^@]*@\([^:]*\):.*|\1|p')
PORT=$(echo "$VLESS_URL" | sed -n 's|vless://[^@]*@[^:]*:\([0-9]*\)?.*|\1|p')
SNI=$(echo "$VLESS_URL" | grep -oE 'sni=[^&]*' | cut -d= -f2 || true)
PUBLIC_KEY=$(echo "$VLESS_URL" | grep -oE 'pbk=[^&]*' | cut -d= -f2 || true)
SHORT_ID=$(echo "$VLESS_URL" | grep -oE 'sid=[^&]*' | cut -d= -f2 || true)
NAME=$(echo "$VLESS_URL" | sed -n 's|.*#\(.*\)|\1|p')

if [[ -z "$UUID" || -z "$HOST" || -z "$PUBLIC_KEY" || -z "$SHORT_ID" ]]; then
    echo -e "${RED}Error: Could not parse VLESS URL${NC}"
    echo "URL: $VLESS_URL"
    exit 1
fi

PORT=${PORT:-443}
SNI=${SNI:-dl.google.com}
NAME=${NAME:-client}

echo -e "${GREEN}Generating config for: $NAME${NC}"
echo "  Server: $HOST:$PORT"
echo "  UUID: ${UUID:0:8}..."
echo "  SNI: $SNI"

# Export shared vars for render-config (server vars come from servers.json)
export UUID HOME

echo "  Mode: thin VLESS client (corp/tailnet access via VPN exit)"

# Output directories
OUTPUT_DIR="$PROJECT_DIR/config/client/generated"
PACKAGE_DIR="$OUTPUT_DIR/$NAME"
mkdir -p "$PACKAGE_DIR"

# Render configs (sing-box-auto + xray-xhttp) — forward any render flags.
# render-config writes the xray config to $XRAY_OUTPUT only for proto=all|xhttp;
# proto=tcp-vision skips it. Pre-delete $XRAY_OUTPUT so we never bundle a
# stale file left over from a previous run with a DIFFERENT device's UUID.
# Env overrides: SINGBOX_OUTPUT / XRAY_OUTPUT can be pre-set to redirect
# render-config's outputs to temp files (used by throwaway-client data-path
# gates that must not clobber the live laptop configs). Defaults preserve
# prior behavior — sing-box config in the package dir, xray config at the
# laptop's live location for the package-builder's own use.
#
# The package bundle ALWAYS needs config-auto.json at the canonical path so
# vpn-install finds it; if SINGBOX_OUTPUT redirects elsewhere, we copy back
# after render. Pass the resolved path as a positional arg (not via env)
# so an unrelated stray positional in RENDER_FLAGS can't redirect render
# behind our back.
PKG_CONFIG_FILE="$PACKAGE_DIR/config-auto.json"
CONFIG_FILE="${SINGBOX_OUTPUT:-$PKG_CONFIG_FILE}"
XRAY_CONFIG_FILE="$PACKAGE_DIR/xray-config.json"
XRAY_OUTPUT="${XRAY_OUTPUT:-$HOME/.config/xray/config.json}"
# Pre-delete BOTH the render output and the in-package xray config, so a
# previous run that produced xray-config.json (--proto all|xhttp) doesn't
# leave a stale file in the package when this run skips xray
# (--proto tcp-vision → render-config writes nothing to $XRAY_OUTPUT).
rm -f "$XRAY_OUTPUT" "$XRAY_CONFIG_FILE"
export XRAY_OUTPUT
"$SCRIPT_DIR/render-config" "${RENDER_FLAGS[@]}" "$CONFIG_FILE"
# Ensure the package always has config-auto.json even when SINGBOX_OUTPUT
# redirected the render somewhere outside $PACKAGE_DIR.
[[ "$CONFIG_FILE" != "$PKG_CONFIG_FILE" ]] && cp "$CONFIG_FILE" "$PKG_CONFIG_FILE"
# Copy freshly-rendered xray config into the package (absent for tcp-vision).
if [[ -f "$XRAY_OUTPUT" ]]; then
    cp "$XRAY_OUTPUT" "$XRAY_CONFIG_FILE"
fi

# Also save a copy with device name
cp "$CONFIG_FILE" "$OUTPUT_DIR/${NAME}-config.json"
echo -e "${GREEN}Config saved: $CONFIG_FILE${NC}"

# Validate config
if "$SCRIPT_DIR/validate-config" "$CONFIG_FILE"; then
    echo -e "${GREEN}Config validated${NC}"
else
    echo -e "${YELLOW}Warning: Config validation failed${NC}"
fi

# Copy scripts from scripts/ directory
echo "Copying scripts..."
for script in vpn-start vpn-stop vpn-install configure-search-domain render-config validate-config bb-dpi-logrotate; do
    cp "$SCRIPT_DIR/$script" "$PACKAGE_DIR/"
done
chmod +x "$PACKAGE_DIR"/*

# Bundle servers.json — keep ONLY the fields render-config actually reads.
# Allow-list (not denylist) so a new server-side field added in the future
# doesn't silently ship to clients. Fields shipped: name, host, public_key,
# short_id, xhttp_path, xhttp_sni, sni. Everything else (private_key, ssh,
# xhttp_dest, sni_dest, relay_upstream, client_render, …) stays on the
# operator's machine. client_render is dropped because filtering by it has
# already happened on this jq line; bundled entries are all visible by
# definition.
jq '[.[] | select(.client_render != false) | {name, host, public_key, short_id, xhttp_path, xhttp_sni, sni}]' "$PROJECT_DIR/servers.json" > "$PACKAGE_DIR/servers.json"
cp "$PROJECT_DIR/config/client/sing-box-skeleton.json" "$PACKAGE_DIR/"
cp "$PROJECT_DIR/config/client/xray-xhttp-skeleton.json" "$PACKAGE_DIR/"

# Rule-set seeds (sing-box initial_path rule-sets/{tag}.srs). vpn-install
# copies them to ~/.config/sing-box/rule-sets/ so the first start does not
# depend on downloading 25 rule-sets from GitHub. Fails the package build
# if any seed cannot be fetched.
echo "Fetching rule-set seeds..."
rm -rf "$PACKAGE_DIR/rule-sets"
"$SCRIPT_DIR/fetch-rule-sets" "$PACKAGE_DIR/rule-sets" "$PROJECT_DIR/config/client/sing-box-skeleton.json"

# Bundle launchd plists — vpn-install renders ${HOME} and installs them.
cp "$PROJECT_DIR/config/client/com.xray-xhttp.plist" "$PACKAGE_DIR/"
cp "$PROJECT_DIR/config/client/com.sing-box-vpn.plist" "$PACKAGE_DIR/"
cp "$PROJECT_DIR/config/client/com.bb-dpi.logrotate.plist" "$PACKAGE_DIR/"

# Copy diagnose script
if [[ -f "$PROJECT_DIR/local/scripts/network-diag.sh" ]]; then
    cp "$PROJECT_DIR/local/scripts/network-diag.sh" "$PACKAGE_DIR/diagnose.sh"
    chmod +x "$PACKAGE_DIR/diagnose.sh"
fi

# Build optional Files-table rows so the table reflects what's actually
# shipped in this package, not a static superset.
if [[ -f "$XRAY_CONFIG_FILE" ]]; then
    XRAY_ROW="| xray-config.json | xray-core configuration (XHTTP SOCKS chain) |
"
else
    XRAY_ROW=""
fi

cat > "$PACKAGE_DIR/README.md" << EOF
# XRay VPN Setup for $NAME

## Quick Install

\`\`\`bash
cd $NAME
./vpn-install
\`\`\`

## Manual Usage

### Start VPN
\`\`\`bash
./vpn-start
# Or after install: ~/VPN-Start.command
\`\`\`

### Stop VPN
\`\`\`bash
./vpn-stop
# Or: Ctrl+C in terminal
# Or after install: ~/VPN-Stop.command
\`\`\`

### Verify
\`\`\`bash
curl ifconfig.me
# Should show: $HOST
\`\`\`

## Search Domain

The VPN configures \`\$COMPANY_DOMAIN\` as macOS search domain:
\`\`\`bash
ssh gitlab          # resolves gitlab.\$COMPANY_DOMAIN
ping jira           # resolves jira.\$COMPANY_DOMAIN
\`\`\`

Manage manually:
\`\`\`bash
./configure-search-domain status
./configure-search-domain add
./configure-search-domain remove
\`\`\`

## Corporate / tailnet access

- The Mac is a thin VLESS client with no embedded Tailscale.
- Corporate (\`10.x\`, \`172.16.x\`) and tailnet (\`100.64.x\`) traffic is delegated to the VPN exit, which must run \`tailscale up --accept-routes\` itself (see the main repo's docs/client-setup.md).

## Files

| File | Description |
|------|-------------|
| config-auto.json | sing-box configuration |
${XRAY_ROW}| vpn-start | Start VPN |
| vpn-stop | Stop VPN and cleanup |
| vpn-install | Automated installer (run once on this Mac) |
| com.sing-box-vpn.plist / com.xray-xhttp.plist | launchd service definitions installed to /Library/LaunchDaemons |
| com.bb-dpi.logrotate.plist / bb-dpi-logrotate | log rotation: every 30 min, logs over 20 MB → \`<log>.1.gz\`, live file truncated |
| configure-search-domain | Manage macOS search domain |
| servers.json | Server list (private keys stripped) |
| rule-sets/ | sing-box rule-set seeds, installed to \`~/.config/sing-box/rule-sets/\` (first start works without GitHub) |
| diagnose.sh | Network diagnostics |

> To change protocol / flags later, regenerate this package on the dev machine
> with new \`generate-client-config\` flags and re-run \`./vpn-install\`. There is
> no in-place re-render path on installed clients.
EOF

# Create ZIP
ZIP_FILE="$OUTPUT_DIR/${NAME}-vpn.zip"
cd "$OUTPUT_DIR"
rm -f "${NAME}-vpn.zip"
zip -r "${NAME}-vpn.zip" "$NAME"

echo ""
echo -e "${GREEN}Package created: $ZIP_FILE${NC}"
echo ""
echo "Contents:"
ls -la "$PACKAGE_DIR"
echo ""
echo -e "${YELLOW}To install on client:${NC}"
echo "  1. Transfer ${NAME}-vpn.zip to client"
echo "  2. Unzip and run: ./$NAME/vpn-install"
