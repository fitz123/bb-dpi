#!/bin/bash
#
# Start VPN with auto-failover (XHTTP + TCP+vision)
#
# Both xray-core and sing-box run as launchd services.
# urltest probes both outbounds every 30s with instant failover.
#
# Usage:
#   vpn-start                                # Start with existing configs
#   vpn-start [render-config-flags...]       # Re-render first, then start
#                                            # All args are passed verbatim to render-config
#
# Examples:
#   vpn-start --proto tcp-vision
#   vpn-start --proto xhttp --with-tailscale
#   vpn-start --with-corp-dns
#   vpn-start --with-tailscale --with-corp-dns
#
# Only flags (starting with `-`) are accepted. Positional args (e.g. an
# output path or `-` for stdout) are rejected so vpn-start always
# operates on the canonical $SINGBOX_CONFIG / $XRAY_CONFIG locations.
#

set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SINGBOX_CONFIG="$HOME/.config/sing-box/config-auto.json"
XRAY_CONFIG="$HOME/.config/xray/config.json"
XRAY_SERVICE="com.xray-xhttp"
SINGBOX_SERVICE="com.sing-box-vpn"

# Load .env if it exists
ENV_FILE="$(dirname "$SCRIPT_DIR")/.env"
if [[ -f "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE"
fi

SEARCH_DOMAIN="${COMPANY_DOMAIN:-}"
if [[ -z "$SEARCH_DOMAIN" ]]; then
    echo "Error: COMPANY_DOMAIN is not set. Configure it in .env or export it." >&2
    exit 1
fi

# Reject obvious "positional-looking" args. render-config's positional is
# OUTPUT (a path or `-` for stdout); vpn-start always wants the rendered
# config at the canonical $SINGBOX_CONFIG location so it can validate +
# start services. We only sniff for "-" or non-flag tokens at any position
# — we no longer try to recognise specific flags' values, so unknown args
# (including `--proto`'s value) reach render-config as-is and let it error.
for arg in "$@"; do
    if [[ "$arg" == "-" ]]; then
        echo "Error: vpn-start does not accept the bare '-' output sentinel." >&2
        echo "Run scripts/render-config -  directly if you need stdout output." >&2
        exit 1
    fi
done

# Re-render if any args provided — pass them through verbatim.
# render-config does its own flag validation; let it shout on bad input.
if [[ $# -gt 0 ]]; then
    "$SCRIPT_DIR/render-config" "$@"
fi

# Check sing-box config exists (give the helpful hint before sing-box check
# emits its own less-actionable error).
if [[ ! -f "$SINGBOX_CONFIG" ]]; then
    echo "Error: Config not found: $SINGBOX_CONFIG" >&2
    echo "Re-run with render-config flags to generate (e.g. vpn-start --with-corp-dns)" >&2
    exit 1
fi

# Always validate the config we're about to start — "validate before
# restart" is a repo-wide rule (see AGENTS.md Config Change Safety).
sing-box check -c "$SINGBOX_CONFIG"

# Detect xray need from sing-box config: any xhttp-* socks outbound means
# sing-box expects an xray-provided SOCKS chain on 127.0.0.1
NEEDS_XRAY=$(jq '[.outbounds[]? | select(.type == "socks" and ((.tag // "") | startswith("xhttp-")))] | length > 0' "$SINGBOX_CONFIG")

if [[ "$NEEDS_XRAY" == "true" ]]; then
    if [[ ! -f "$XRAY_CONFIG" ]]; then
        echo "Error: xray config required but not found: $XRAY_CONFIG"
        exit 1
    fi
    timeout 5 xray -test -c "$XRAY_CONFIG"
fi

# Install/update plists (render ${HOME} to actual path)
for plist in "$XRAY_SERVICE" "$SINGBOX_SERVICE"; do
    src="$SCRIPT_DIR/../config/client/${plist}.plist"
    dst="/Library/LaunchDaemons/${plist}.plist"
    if [[ -f "$src" ]]; then
        sed "s|\${HOME}|$HOME|g" "$src" | sudo tee "$dst" > /dev/null
    fi
done

# Start/stop xray based on need
if [[ "$NEEDS_XRAY" == "true" ]]; then
    if sudo launchctl list "$XRAY_SERVICE" > /dev/null 2>&1; then
        sudo launchctl kickstart -k system/${XRAY_SERVICE}
    else
        sudo launchctl load /Library/LaunchDaemons/${XRAY_SERVICE}.plist
    fi
    echo "xray-core started (XHTTP SOCKS on ports 1080+)"
else
    if sudo launchctl list "$XRAY_SERVICE" > /dev/null 2>&1; then
        sudo launchctl bootout system/${XRAY_SERVICE} 2>/dev/null || true
        echo "xray-core stopped (not needed)"
    fi
fi

# Configure search domain
"$SCRIPT_DIR/configure-search-domain" add "$SEARCH_DOMAIN"

# Start/restart sing-box
if sudo launchctl list "$SINGBOX_SERVICE" > /dev/null 2>&1; then
    sudo launchctl kickstart -k system/${SINGBOX_SERVICE}
else
    sudo launchctl load /Library/LaunchDaemons/${SINGBOX_SERVICE}.plist
    sudo launchctl start ${SINGBOX_SERVICE}
fi
echo "sing-box started (auto-failover TUN)"

echo ""
echo "VPN running. Logs:"
echo "  sing-box: $HOME/.config/sing-box/vpn.log"
if [[ "$NEEDS_XRAY" == "true" ]]; then
    echo "  xray:     $HOME/.config/xray/xray.log"
fi
echo ""
echo "Stop with: vpn-stop"
