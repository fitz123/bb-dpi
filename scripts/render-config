#!/bin/bash
#
# Render auto-failover configs (sing-box + xray-core) from templates
#
# Usage:
#   render-config              # Render both configs from templates
#   render-config -            # Output sing-box config to stdout
#
# Environment:
#   Sources .env from project root if present
#   Falls back to users.json for UUID if not in env
#
# Required variables:
#   SERVER, PUBLIC_KEY, SHORT_ID, SNI, UUID, XHTTP_PATH, XHTTP_SNI
#
# Optional variables:
#   TAILSCALE_AUTH_KEY, TAILSCALE_HOSTNAME, INTERNAL_DNS_1, COMPANY_DOMAIN
#

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

SINGBOX_TEMPLATE="$PROJECT_DIR/config/client/sing-box-auto.template.json"
SINGBOX_OUTPUT="$HOME/.config/sing-box/config-auto.json"
XRAY_TEMPLATE="$PROJECT_DIR/config/client/xray-xhttp.template.json"
XRAY_OUTPUT="$HOME/.config/xray/config.json"

OUTPUT="${1:-$SINGBOX_OUTPUT}"

# Load environment
if [[ -f "$PROJECT_DIR/.env" ]]; then
    set -a
    source "$PROJECT_DIR/.env"
    set +a
fi

# Get UUID from users.json if not set
if [[ -z "$UUID" && -f "$PROJECT_DIR/users.json" ]]; then
    UUID=$(jq -r 'keys[0]' "$PROJECT_DIR/users.json")
    export UUID
fi

# Validate required variables
REQUIRED_VARS="SERVER PUBLIC_KEY SHORT_ID SNI UUID XHTTP_PATH XHTTP_SNI"
MISSING=""
for var in $REQUIRED_VARS; do
    if [[ -z "${!var}" ]]; then
        MISSING="$MISSING $var"
    fi
done

if [[ -n "$MISSING" ]]; then
    echo "Error: Missing required variables:$MISSING" >&2
    echo "Set them in .env or environment" >&2
    exit 1
fi

# Warn about optional variables
[[ -z "$TAILSCALE_AUTH_KEY" ]] && echo "Warning: TAILSCALE_AUTH_KEY not set" >&2
[[ -z "$INTERNAL_DNS_1" ]] && echo "Warning: INTERNAL_DNS_1 not set, company DNS disabled" >&2
[[ -z "$COMPANY_DOMAIN" ]] && echo "Warning: COMPANY_DOMAIN not set" >&2

# Check templates exist
for tmpl in "$SINGBOX_TEMPLATE" "$XRAY_TEMPLATE"; do
    if [[ ! -f "$tmpl" ]]; then
        echo "Error: Template not found: $tmpl" >&2
        exit 1
    fi
done

# Render sing-box config
if [[ "$OUTPUT" == "-" ]]; then
    envsubst < "$SINGBOX_TEMPLATE"
else
    mkdir -p "$(dirname "$OUTPUT")"
    envsubst < "$SINGBOX_TEMPLATE" > "$OUTPUT"
    echo "Config rendered: $OUTPUT" >&2
fi

# Render xray-core config
mkdir -p "$(dirname "$XRAY_OUTPUT")"
envsubst < "$XRAY_TEMPLATE" > "$XRAY_OUTPUT"
echo "Config rendered: $XRAY_OUTPUT" >&2
