#!/bin/bash
#
# Render auto-failover configs (sing-box + xray-core) from skeletons + servers.json
#
# Usage:
#   render-config                          # Render both configs (no Tailscale, no corp DNS)
#   render-config --proto tcp-vision       # TCP+vision only (no xray-core needed)
#   render-config --proto xhttp            # XHTTP only (via xray-core SOCKS)
#   render-config -                        # Output sing-box config to stdout
#   render-config --with-tailscale         # Include embedded Tailscale endpoint + magicdns + ts routes
#   render-config --with-corp-dns          # Include corp DNS server (${INTERNAL_DNS_1} from .env); detour follows --with-tailscale
#                                          #   --with-tailscale --with-corp-dns → corp DNS via Tailscale (original behaviour)
#                                          #   --with-corp-dns alone           → corp DNS via VLESS chain (auto outbound)
#
# Reads:
#   servers.json  — array of server objects (host, public_key, short_id, etc.)
#   users.json    — UUID lookup (first key used)
#   .env          — shared params (TAILSCALE_*, COMPANY_DOMAIN, FLOW, FINGERPRINT, etc.)
#

set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

SINGBOX_SKELETON="$PROJECT_DIR/config/client/sing-box-skeleton.json"
SINGBOX_OUTPUT="$HOME/.config/sing-box/config-auto.json"
XRAY_SKELETON="$PROJECT_DIR/config/client/xray-xhttp-skeleton.json"
XRAY_OUTPUT="$HOME/.config/xray/config.json"
SERVERS_FILE="$PROJECT_DIR/servers.json"

# Parse flags
WITH_TAILSCALE=false
WITH_CORP_DNS=false
PROTO="all"  # all | tcp-vision | xhttp
OUTPUT=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --with-tailscale) WITH_TAILSCALE=true ;;
        --with-corp-dns) WITH_CORP_DNS=true ;;
        --proto) PROTO="${2:?Error: --proto requires a value (all, tcp-vision, xhttp)}"; shift ;;
        -)
            if [[ -n "$OUTPUT" ]]; then
                echo "Error: unexpected extra positional argument: - (already set output to $OUTPUT)" >&2
                exit 1
            fi
            OUTPUT="-"
            ;;
        --*)
            echo "Error: unknown option: $1" >&2
            exit 1
            ;;
        -*)
            echo "Error: unknown option: $1 (only the bare '-' stdout sentinel is accepted as short-form)" >&2
            exit 1
            ;;
        *)
            if [[ -n "$OUTPUT" ]]; then
                echo "Error: unexpected extra positional argument: $1 (already set output to $OUTPUT)" >&2
                exit 1
            fi
            OUTPUT="$1"
            ;;
    esac
    shift
done
OUTPUT="${OUTPUT:-$SINGBOX_OUTPUT}"

case "$PROTO" in all|tcp-vision|xhttp) ;; *)
    echo "Error: --proto must be all, tcp-vision, or xhttp (got: $PROTO)" >&2; exit 1 ;; esac

# Load shared environment
if [[ -f "$PROJECT_DIR/.env" ]]; then
    set -a
    source "$PROJECT_DIR/.env"
    set +a
fi

# Get UUID from users.json if not set
if [[ -z "${UUID:-}" && -f "$PROJECT_DIR/users.json" ]]; then
    UUID=$(jq -r 'keys[0]' "$PROJECT_DIR/users.json")
    export UUID
fi

# Validate
if [[ -z "${UUID:-}" ]]; then
    echo "Error: UUID not set and no users.json found" >&2
    exit 1
fi

if [[ ! -f "$SERVERS_FILE" ]]; then
    echo "Error: servers.json not found at $SERVERS_FILE" >&2
    exit 1
fi

SERVER_COUNT=$(jq 'length' "$SERVERS_FILE")
if [[ "$SERVER_COUNT" -eq 0 ]]; then
    echo "Error: servers.json is empty" >&2
    exit 1
fi

# Count client-visible servers (client_render != false). Without at least one
# visible server, sing-box's auto outbound would be rendered with an empty
# outbounds list — TUN comes up but routes traffic to a non-existent peer
# (silent connectivity blackhole).
VISIBLE_COUNT=$(jq '[.[] | select(.client_render != false)] | length' "$SERVERS_FILE")
if [[ "$VISIBLE_COUNT" -eq 0 ]]; then
    echo "Error: no client-visible servers in $SERVERS_FILE (all entries have client_render:false)" >&2
    exit 1
fi

for tmpl in "$SINGBOX_SKELETON" "$XRAY_SKELETON"; do
    if [[ ! -f "$tmpl" ]]; then
        echo "Error: Skeleton not found: $tmpl" >&2
        exit 1
    fi
done

if [[ "$WITH_TAILSCALE" == true ]]; then
    [[ -z "${TAILSCALE_AUTH_KEY:-}" ]] && echo "Warning: TAILSCALE_AUTH_KEY not set" >&2
fi
if [[ "$WITH_CORP_DNS" == true ]]; then
    # Both vars are interpolated into the skeleton by envsubst. If either
    # is empty the rendered config gets `server: ""` / `domain_suffix: [""]`
    # — broken corp DNS that sing-box check might still accept syntactically
    # but won't resolve anything. Hard-fail rather than ship a silent dud.
    if [[ -z "${INTERNAL_DNS_1:-}" ]]; then
        echo "Error: INTERNAL_DNS_1 is required when --with-corp-dns is set. Configure it in .env or export it." >&2
        exit 1
    fi
    if [[ -z "${COMPANY_DOMAIN:-}" ]]; then
        echo "Error: COMPANY_DOMAIN is required when --with-corp-dns is set. Configure it in .env or export it." >&2
        exit 1
    fi
fi

# --- Render sing-box config ---
render_singbox() {
    # Step 1: envsubst for shared vars
    local config
    config=$(envsubst '$HOME $UUID $TAILSCALE_AUTH_KEY $TAILSCALE_HOSTNAME $INTERNAL_DNS_1 $COMPANY_DOMAIN' < "$SINGBOX_SKELETON")

    # Step 2: jq — inject server outbounds from servers.json
    config=$(echo "$config" | jq \
        --slurpfile servers "$SERVERS_FILE" \
        --arg uuid "$UUID" \
        --arg flow "${FLOW:-xtls-rprx-vision}" \
        --arg fingerprint "${FINGERPRINT:-chrome}" \
        --arg proto "$PROTO" \
        '
        # Keep only servers that should appear in client configs.
        # client_render defaults to true when absent; only explicit false hides
        # an entry (used for upstream-only relay targets, e.g. aws-st in a chain).
        # Filtering BEFORE to_entries ensures SOCKS-port indices stay sequential.
        ($servers[0] | map(select(.client_render != false))) as $visible |

        # Build route_exclude_address from visible server hosts
        .inbounds[0].route_exclude_address = [$visible[] | "\(.host)/32"] |

        # Define per-server outbounds based on --proto flag
        def xhttp_outbound(i; s):
            {
                type: "socks",
                tag: ("xhttp-" + s.name),
                server: "127.0.0.1",
                server_port: (1080 + i),
                connect_timeout: "10s"
            };
        def tcp_outbound(s):
            {
                type: "vless",
                tag: ("tcp-" + s.name),
                server: s.host,
                server_port: 8443,
                uuid: $uuid,
                flow: $flow,
                connect_timeout: "10s",
                tcp_fast_open: false,
                tls: {
                    enabled: true,
                    server_name: s.sni,
                    utls: {
                        enabled: true,
                        fingerprint: $fingerprint
                    },
                    reality: {
                        enabled: true,
                        public_key: s.public_key,
                        short_id: s.short_id
                    }
                }
            };

        # Build urltest tag list based on proto
        def urltest_tags:
            if $proto == "tcp-vision" then
                [$visible[] | "tcp-" + .name]
            elif $proto == "xhttp" then
                [$visible[] | "xhttp-" + .name]
            else
                [$visible[] | ("xhttp-" + .name), ("tcp-" + .name)]
            end;

        # Build server outbounds based on proto
        def server_outbounds:
            [$visible | to_entries[] | {i: .key, s: .value} |
                if $proto == "tcp-vision" then
                    tcp_outbound(.s)
                elif $proto == "xhttp" then
                    xhttp_outbound(.i; .s)
                else
                    xhttp_outbound(.i; .s), tcp_outbound(.s)
                end
            ];

        .outbounds = [
            (.outbounds[] | select(.tag == "auto")) * { outbounds: urltest_tags }
        ] + server_outbounds + [
            .outbounds[] | select(.tag != "auto")
        ]
        ')

    # Strip embedded Tailscale endpoint and magicdns unless --with-tailscale.
    # Rewrite remaining tailscale-bound route rules to use the VLESS chain (auto)
    # so corp/tailnet IP traffic still tunnels — just via the upstream VPN exit
    # instead of an embedded tsnet. preferred_by-tailscale rules have no
    # equivalent without the endpoint, so they're dropped.
    if [[ "$WITH_TAILSCALE" == false ]]; then
        config=$(echo "$config" | jq '
            del(.endpoints) |
            .dns.servers |= map(select(.tag != "magicdns")) |
            .dns.rules |= map(select(.server != "magicdns")) |
            .route.rules |= map(select((.preferred_by // []) | index("tailscale") | not)) |
            .route.rules |= map(if .outbound == "tailscale" then .outbound = "auto" else . end)
        ')
    fi

    # Strip corp DNS server + rules unless --with-corp-dns was passed.
    if [[ "$WITH_CORP_DNS" == false ]]; then
        config=$(echo "$config" | jq '
            .dns.servers |= map(select(.tag != "company-dns")) |
            .dns.rules |= map(select(.server != "company-dns"))
        ')
    fi

    # If keeping corp DNS but tsnet is gone, route corp DNS through the VLESS chain.
    if [[ "$WITH_CORP_DNS" == true && "$WITH_TAILSCALE" == false ]]; then
        config=$(echo "$config" | jq '
            .dns.servers |= map(if .tag == "company-dns" then .detour = "auto" else . end)
        ')
    fi

    echo "$config"
}

# --- Render xray-xhttp config ---
render_xray() {
    local config
    config=$(cat "$XRAY_SKELETON")

    config=$(echo "$config" | jq \
        --slurpfile servers "$SERVERS_FILE" \
        --arg uuid "$UUID" \
        '
        # Keep only servers that should appear in client configs (see render_singbox above).
        ($servers[0] | map(select(.client_render != false))) as $visible |

        # Build inbounds: one SOCKS listener per visible server
        .inbounds = [
            $visible | to_entries[] |
            {i: .key, s: .value} |
            {
                tag: ("socks-in-" + .s.name),
                protocol: "socks",
                listen: "127.0.0.1",
                port: (1080 + .i),
                settings: { udp: true }
            }
        ] |

        # Build outbounds: one VLESS+XHTTP per visible server, plus direct
        .outbounds = [
            $visible[] |
            {
                tag: ("xhttp-" + .name),
                protocol: "vless",
                settings: {
                    vnext: [{
                        address: .host,
                        port: 443,
                        users: [{ id: $uuid, encryption: "none" }]
                    }]
                },
                streamSettings: {
                    network: "xhttp",
                    xhttpSettings: {
                        path: ("/" + .xhttp_path)
                    },
                    security: "reality",
                    realitySettings: {
                        serverName: .xhttp_sni,
                        publicKey: .public_key,
                        shortId: .short_id,
                        fingerprint: "chrome"
                    }
                }
            }
        ] + [
            { tag: "direct", protocol: "freedom" }
        ] |

        # Build routing rules: inbound→outbound mapping per visible server, plus geoip:private→direct
        .routing.rules = [
            $visible[] |
            {
                type: "field",
                inboundTag: ["socks-in-" + .name],
                outboundTag: ("xhttp-" + .name)
            }
        ] + [
            { type: "field", ip: ["geoip:private"], outboundTag: "direct" }
        ]
        ')

    echo "$config"
}

# Output sing-box config
if [[ "$OUTPUT" == "-" ]]; then
    render_singbox
else
    mkdir -p "$(dirname "$OUTPUT")"
    render_singbox > "$OUTPUT"
    echo "Config rendered: $OUTPUT ($VISIBLE_COUNT/$SERVER_COUNT servers visible)" >&2
fi

# Render xray-core config (skip in stdout mode or tcp-vision only)
if [[ "$OUTPUT" != "-" && "$PROTO" != "tcp-vision" ]]; then
    mkdir -p "$(dirname "$XRAY_OUTPUT")"
    render_xray > "$XRAY_OUTPUT"
    echo "Config rendered: $XRAY_OUTPUT ($VISIBLE_COUNT/$SERVER_COUNT servers visible)" >&2
fi
