#!/bin/bash
#
# scripts/test-publish-bundle — semantic guard for the publish-bundle
# allowlist. Replaces a lexical grep (which false-positives on the
# script's own allowlist-justification comments).
#
# Method:
#   1. Build a throwaway project tree under a temp dir, populated with:
#      - servers.json containing every FORBIDDEN field (private_key,
#        ssh, xhttp_dest, sni_dest, relay_upstream, client_render=false)
#        plus the ALLOWED fields, on two synthetic server entries.
#      - Real config/client/*-skeleton.json (copied from this repo).
#      - config/control-plane/{render.json,package-manifest.json,
#        token,endpoints.json} (token + endpoints.json synthesized).
#   2. Run scripts/publish-bundle --dry-run against the throwaway tree.
#   3. Assert:
#      a. Each server entry's key SET equals exactly
#         {name, host, public_key, short_id, xhttp_path, xhttp_sni, sni}.
#      b. No server entry contains any forbidden field name.
#      c. Servers with client_render=false are absent from the bundle.
#      d. bundle.min_versions matches package-manifest.json.
#      e. bundle.schema_version == 1.
#
# Exit codes:
#   0 — allowlist holds
#   1 — leak detected or test infrastructure error
#

set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

fail() { echo -e "${RED}FAIL: $*${NC}" >&2; exit 1; }
pass() { echo -e "${GREEN}PASS: $*${NC}"; }

# Synthetic corp-DNS env values seeded into the throwaway tree's .env
# so publish-bundle's corp-DNS validation has values when the test
# project's render.json has with_corp_dns: true. Real values stay on
# the dev machine; these are deliberate placeholders.
SYNTHETIC_INTERNAL_DNS_1="10.10.10.10"
SYNTHETIC_COMPANY_DOMAIN="example.invalid"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# Synthetic project tree mirroring the real layout
mkdir -p "$TMP/config/client" "$TMP/config/control-plane" "$TMP/scripts"

# Synthetic servers.json — two servers:
#   visible: has all allowed fields PLUS every forbidden field
#   hidden:  client_render=false (must be filtered out entirely)
cat > "$TMP/servers.json" <<'JSON'
[
  {
    "name": "visible",
    "host": "127.0.0.1",
    "public_key": "PUB_VISIBLE",
    "short_id": "abcd1234",
    "xhttp_path": "/p",
    "xhttp_sni": "sni.example.com",
    "sni": "cover.example.com",
    "private_key": "PRIV_VISIBLE_LEAK_THIS_BREAKS",
    "ssh": "synthetic-ssh-target-1",
    "xhttp_dest": "127.0.0.1:8081",
    "sni_dest": "cover.example.com:443",
    "relay_upstream": "upstream-host"
  },
  {
    "name": "hidden",
    "host": "127.0.0.2",
    "public_key": "PUB_HIDDEN",
    "short_id": "deadbeef",
    "xhttp_path": "/q",
    "xhttp_sni": "sni2.example.com",
    "sni": "cover2.example.com",
    "client_render": false,
    "private_key": "PRIV_HIDDEN_LEAK_THIS_BREAKS",
    "ssh": "synthetic-ssh-target-2"
  }
]
JSON

# Real skeletons (copied from the repo so we exercise the same shape)
cp "$PROJECT_DIR/config/client/sing-box-skeleton.json"   "$TMP/config/client/"
cp "$PROJECT_DIR/config/client/xray-xhttp-skeleton.json" "$TMP/config/client/"

# Real render.json + package-manifest.json
cp "$PROJECT_DIR/config/control-plane/render.json"           "$TMP/config/control-plane/"
cp "$PROJECT_DIR/config/control-plane/package-manifest.json" "$TMP/config/control-plane/"

# Synthetic .env so publish-bundle has values for INTERNAL_DNS_1 +
# COMPANY_DOMAIN. Required when render.with_corp_dns is true; harmless
# otherwise. publish-bundle sources $PROJECT_DIR/.env which resolves to
# $TMP/.env once it's copied to $TMP/scripts/.
cat > "$TMP/.env" <<ENV
INTERNAL_DNS_1=$SYNTHETIC_INTERNAL_DNS_1
COMPANY_DOMAIN=$SYNTHETIC_COMPANY_DOMAIN
ENV

# Synthetic token + endpoints.json (dry-run won't actually publish)
echo "test-token-not-real" > "$TMP/config/control-plane/token"
cat > "$TMP/config/control-plane/endpoints.json" <<'JSON'
[
  {
    "label": "test",
    "url": "https://example.invalid/control/bundle.json",
    "host_ip": "0.0.0.0",
    "sni": "example.invalid",
    "ssh": "nobody@example.invalid",
    "remote_bundle_path": "/etc/bb-dpi/bundle.json",
    "placeholder": true
  }
]
JSON

# Copy publish-bundle into the throwaway tree so its $PROJECT_DIR
# resolves to $TMP, not the real repo.
cp "$PROJECT_DIR/scripts/publish-bundle" "$TMP/scripts/"
chmod +x "$TMP/scripts/publish-bundle"

# Run dry-run and capture
BUNDLE=$("$TMP/scripts/publish-bundle" --dry-run)

# --- assertions ---

# a) bundle.schema_version == 1
SCHEMA=$(echo "$BUNDLE" | jq -r '.schema_version')
[[ "$SCHEMA" == "1" ]] || fail "schema_version is '$SCHEMA', expected 1"
pass "schema_version == 1"

# b) bundle.min_versions matches package-manifest.json
EXPECTED_MIN=$(jq '{bb_vpn, sing_box, xray}' "$PROJECT_DIR/config/control-plane/package-manifest.json")
ACTUAL_MIN=$(echo "$BUNDLE" | jq '.min_versions')
if [[ "$(echo "$EXPECTED_MIN" | jq -S -c .)" != "$(echo "$ACTUAL_MIN" | jq -S -c .)" ]]; then
    fail "min_versions mismatch. expected=$EXPECTED_MIN got=$ACTUAL_MIN"
fi
pass "min_versions matches package-manifest.json"

# c) client_render=false entry is absent
SERVER_NAMES=$(echo "$BUNDLE" | jq -r '.servers[].name')
if echo "$SERVER_NAMES" | grep -qx "hidden"; then
    fail "client_render=false server 'hidden' leaked into the bundle"
fi
pass "client_render=false server is filtered out"

# d) exactly the allowlist keys appear on every visible server
ALLOWED="host name public_key short_id sni xhttp_path xhttp_sni"
EXPECTED_KEYS=$(echo "$ALLOWED" | tr ' ' '\n' | sort -u | tr '\n' ' ')

NUM_SERVERS=$(echo "$BUNDLE" | jq '.servers | length')
for ((i=0; i<NUM_SERVERS; i++)); do
    ACTUAL_KEYS=$(echo "$BUNDLE" | jq -r ".servers[$i] | keys[]" | sort -u | tr '\n' ' ')
    if [[ "$ACTUAL_KEYS" != "$EXPECTED_KEYS" ]]; then
        fail "server[$i] key set != allowlist
       expected: $EXPECTED_KEYS
       actual:   $ACTUAL_KEYS"
    fi
done
pass "every server has exactly the allowlist key set"

# e) no forbidden field appears anywhere in .servers[]
FORBIDDEN_PATTERN='"(private_key|ssh|xhttp_dest|sni_dest|relay_upstream|client_render)"[[:space:]]*:'
SERVERS_BLOB=$(echo "$BUNDLE" | jq -c '.servers')
if echo "$SERVERS_BLOB" | grep -E -q "$FORBIDDEN_PATTERN"; then
    fail "forbidden field leaked into .servers (see output)
$(echo "$SERVERS_BLOB" | grep -E "$FORBIDDEN_PATTERN" || true)"
fi
pass "no forbidden field name appears in .servers"

# f) leaked secret values from the synthetic input are absent anywhere
#    in the bundle (defends against a renderer that projects under a
#    different key name)
if echo "$BUNDLE" | grep -qE "PRIV_VISIBLE_LEAK_THIS_BREAKS|PRIV_HIDDEN_LEAK_THIS_BREAKS|synthetic-ssh-target"; then
    fail "synthetic-secret string leaked into bundle"
fi
pass "no synthetic-secret value appears in bundle body"

# --- corp-DNS embedding tests (Task 3) -------------------------------
#
# publish-bundle must augment the render block with internal_dns_1 +
# company_domain when render.with_corp_dns is true, and must leave them
# absent otherwise. Render-block allowlist (assertion below) permits
# those two fields alongside the base render flags.

RENDER_ALLOWED="company_domain internal_dns_1 proto with_corp_dns with_tailscale"

# Helper: rewrite render.json + (optionally) overwrite the .env file,
# then run publish-bundle --dry-run. Sets BUNDLE on success; sets
# CAPTURED_ERR + CAPTURED_RC on failure. Caller decides which to assert.
run_dryrun() {
    local render_body="$1"  # JSON for render.json contents
    local env_body="$2"     # raw shell .env body (may be empty)
    # Unset corp-DNS vars from the runner's environment so the only
    # source of values is the synthetic $TMP/.env we write below.
    # publish-bundle's `set -a; source .env; set +a` does NOT clobber
    # pre-existing exported vars — without this unset, Case 2 (missing
    # env) would falsely pass on any dev shell that has those exported
    # (operator's .zshrc, direnv, manually-sourced .env, etc.).
    unset INTERNAL_DNS_1 COMPANY_DOMAIN
    echo "$render_body" > "$TMP/config/control-plane/render.json"
    printf '%s' "$env_body" > "$TMP/.env"
    set +e
    CAPTURED_OUT=$("$TMP/scripts/publish-bundle" --dry-run 2>&1)
    CAPTURED_RC=$?
    set -e
}

# Case 1: with_corp_dns=true + env set → both fields embedded with the
# synthetic values.
run_dryrun '{"proto":"xhttp","with_corp_dns":true,"with_tailscale":false}' \
           "INTERNAL_DNS_1=$SYNTHETIC_INTERNAL_DNS_1
COMPANY_DOMAIN=$SYNTHETIC_COMPANY_DOMAIN
"
if [[ "$CAPTURED_RC" -ne 0 ]]; then
    fail "with_corp_dns=true + env set: publish-bundle exited $CAPTURED_RC
$CAPTURED_OUT"
fi
EMB_DNS=$(echo "$CAPTURED_OUT" | jq -r '.render.internal_dns_1 // ""')
EMB_DOM=$(echo "$CAPTURED_OUT" | jq -r '.render.company_domain // ""')
[[ "$EMB_DNS" == "$SYNTHETIC_INTERNAL_DNS_1" ]] \
    || fail "with_corp_dns=true: render.internal_dns_1 = '$EMB_DNS' (want $SYNTHETIC_INTERNAL_DNS_1)"
[[ "$EMB_DOM" == "$SYNTHETIC_COMPANY_DOMAIN" ]] \
    || fail "with_corp_dns=true: render.company_domain = '$EMB_DOM' (want $SYNTHETIC_COMPANY_DOMAIN)"
pass "with_corp_dns=true + env set → both fields embedded"

# Render-block allowlist (sub-case of case 1, since both fields are
# present here): no field outside the documented set should appear.
RENDER_KEYS=$(echo "$CAPTURED_OUT" | jq -r '.render | keys[]' | sort -u | tr '\n' ' ')
EXPECTED_RENDER_KEYS=$(echo "$RENDER_ALLOWED" | tr ' ' '\n' | sort -u | tr '\n' ' ')
if [[ "$RENDER_KEYS" != "$EXPECTED_RENDER_KEYS" ]]; then
    fail "render block key set != allowlist
       expected: $EXPECTED_RENDER_KEYS
       actual:   $RENDER_KEYS"
fi
pass "render block key set matches allowlist (with corp-DNS fields)"

# Case 2: with_corp_dns=true + env missing → publish-bundle exits
# non-zero with an operator-actionable message naming the empty var.
# Try INTERNAL_DNS_1 missing.
run_dryrun '{"proto":"xhttp","with_corp_dns":true,"with_tailscale":false}' \
           "COMPANY_DOMAIN=$SYNTHETIC_COMPANY_DOMAIN
"
if [[ "$CAPTURED_RC" -eq 0 ]]; then
    fail "with_corp_dns=true + INTERNAL_DNS_1 missing: publish-bundle exited 0 (expected non-zero)
$CAPTURED_OUT"
fi
if ! echo "$CAPTURED_OUT" | grep -q "INTERNAL_DNS_1"; then
    fail "with_corp_dns=true + INTERNAL_DNS_1 missing: error message does not name INTERNAL_DNS_1
$CAPTURED_OUT"
fi
pass "with_corp_dns=true + INTERNAL_DNS_1 missing → non-zero exit, message names INTERNAL_DNS_1"

# Same, COMPANY_DOMAIN missing.
run_dryrun '{"proto":"xhttp","with_corp_dns":true,"with_tailscale":false}' \
           "INTERNAL_DNS_1=$SYNTHETIC_INTERNAL_DNS_1
"
if [[ "$CAPTURED_RC" -eq 0 ]]; then
    fail "with_corp_dns=true + COMPANY_DOMAIN missing: publish-bundle exited 0 (expected non-zero)
$CAPTURED_OUT"
fi
if ! echo "$CAPTURED_OUT" | grep -q "COMPANY_DOMAIN"; then
    fail "with_corp_dns=true + COMPANY_DOMAIN missing: error message does not name COMPANY_DOMAIN
$CAPTURED_OUT"
fi
pass "with_corp_dns=true + COMPANY_DOMAIN missing → non-zero exit, message names COMPANY_DOMAIN"

# Case 3: with_corp_dns=false → neither field appears in the bundle,
# even when the env vars ARE set in .env. Smaller bundle, no
# incidental leak of corp DNS / company domain.
run_dryrun '{"proto":"xhttp","with_corp_dns":false,"with_tailscale":false}' \
           "INTERNAL_DNS_1=$SYNTHETIC_INTERNAL_DNS_1
COMPANY_DOMAIN=$SYNTHETIC_COMPANY_DOMAIN
"
if [[ "$CAPTURED_RC" -ne 0 ]]; then
    fail "with_corp_dns=false: publish-bundle exited $CAPTURED_RC
$CAPTURED_OUT"
fi
HAS_DNS=$(echo "$CAPTURED_OUT" | jq -r '.render.internal_dns_1 // empty')
HAS_DOM=$(echo "$CAPTURED_OUT" | jq -r '.render.company_domain // empty')
[[ -z "$HAS_DNS" ]] || fail "with_corp_dns=false: render.internal_dns_1 present ('$HAS_DNS')"
[[ -z "$HAS_DOM" ]] || fail "with_corp_dns=false: render.company_domain present ('$HAS_DOM')"
if echo "$CAPTURED_OUT" | grep -qE "$SYNTHETIC_INTERNAL_DNS_1|$SYNTHETIC_COMPANY_DOMAIN"; then
    fail "with_corp_dns=false: synthetic env value leaked into bundle anyway
$(echo "$CAPTURED_OUT" | grep -E "$SYNTHETIC_INTERNAL_DNS_1|$SYNTHETIC_COMPANY_DOMAIN" || true)"
fi
pass "with_corp_dns=false → neither field appears, env values not leaked"

# Case 4: with_corp_dns=false BUT render.json is hand-edited to carry
# the corp-DNS fields anyway (operator forgot to strip them after
# flipping with_corp_dns to false). publish-bundle must explicitly DROP
# those fields from the rendered bundle — otherwise they leak into the
# wire format and trip parse-strict daemons on older clients that
# didn't anticipate them. Regression guard for codex iter-1.
run_dryrun '{"proto":"xhttp","with_corp_dns":false,"with_tailscale":false,"internal_dns_1":"leaked.example.invalid","company_domain":"leaked-domain.invalid"}' \
           "INTERNAL_DNS_1=$SYNTHETIC_INTERNAL_DNS_1
COMPANY_DOMAIN=$SYNTHETIC_COMPANY_DOMAIN
"
if [[ "$CAPTURED_RC" -ne 0 ]]; then
    fail "with_corp_dns=false + hand-edited render.json: publish-bundle exited $CAPTURED_RC
$CAPTURED_OUT"
fi
LEAKED_DNS=$(echo "$CAPTURED_OUT" | jq -r '.render.internal_dns_1 // empty')
LEAKED_DOM=$(echo "$CAPTURED_OUT" | jq -r '.render.company_domain // empty')
[[ -z "$LEAKED_DNS" ]] || fail "with_corp_dns=false + hand-edit: render.internal_dns_1 leaked through ('$LEAKED_DNS')"
[[ -z "$LEAKED_DOM" ]] || fail "with_corp_dns=false + hand-edit: render.company_domain leaked through ('$LEAKED_DOM')"
if echo "$CAPTURED_OUT" | grep -qE "leaked\.example\.invalid|leaked-domain\.invalid"; then
    fail "with_corp_dns=false + hand-edit: stale render.json value leaked into bundle
$(echo "$CAPTURED_OUT" | grep -E "leaked\.example\.invalid|leaked-domain\.invalid" || true)"
fi
pass "with_corp_dns=false + hand-edited fields → fields stripped from bundle"

echo ""
pass "test-publish-bundle: all assertions passed"
