#!/bin/bash
#
# Stop VPN (sing-box + xray-core) and clean up search domain
#
# Usage:
#   vpn-stop
#

XRAY_SERVICE="com.xray-xhttp"
SINGBOX_SERVICE="com.sing-box-vpn"

echo "Stopping VPN..."

# Unload sing-box (unload fully stops KeepAlive services)
if [[ -f "/Library/LaunchDaemons/${SINGBOX_SERVICE}.plist" ]]; then
    sudo launchctl unload "/Library/LaunchDaemons/${SINGBOX_SERVICE}.plist" 2>/dev/null || true
fi
sudo pkill -f "sing-box run" 2>/dev/null || true

# Unload xray-core
if [[ -f "/Library/LaunchDaemons/${XRAY_SERVICE}.plist" ]]; then
    sudo launchctl unload "/Library/LaunchDaemons/${XRAY_SERVICE}.plist" 2>/dev/null || true
fi
sudo pkill -f "xray run" 2>/dev/null || true

# Remove search domain
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SEARCH_DOMAIN_SCRIPT="$SCRIPT_DIR/configure-search-domain"

if [[ -x "$SEARCH_DOMAIN_SCRIPT" ]]; then
    "$SEARCH_DOMAIN_SCRIPT" remove
else
    sudo scutil <<EOF 2>/dev/null || true
remove State:/Network/Service/sing-box-dns/DNS
quit
EOF
fi

echo "VPN stopped."
