#!/bin/bash
#
# scripts/test-cover-fingerprint — verify that an unauthenticated GET to
# /control/bundle.json is byte-indistinguishable from a GET to a random
# nonexistent path on the same cover site. If they differ, the cover-site
# disguise is broken (the endpoint becomes fingerprintable to RU DPI).
#
# Usage:
#   ./scripts/test-cover-fingerprint            # iterate endpoints.json
#   ./scripts/test-cover-fingerprint <URL>      # one-off probe against URL
#   ./scripts/test-cover-fingerprint --strict   # byte-exact body match (else tolerance)
#
# Method:
#   For each (cover_url):
#     - GET /control/bundle.json (no Authorization).
#     - GET /random-nonexistent-<rand> 5 times (baseline determinism).
#     - If baseline non-deterministic across the 5 runs:
#         SKIP — cover site has dynamic content, this check can't apply.
#     - Else: assert
#         * HTTP status matches
#         * Content-Type matches
#         * Content-Length within ±32B (or exact in --strict)
#         * Normalized body sha256 matches
#       Normalization strips ISO8601 timestamps and UUID-shaped substrings,
#       and the response headers exclude {Date, Server-Timing, X-Request-Id,
#       X-Trace-Id, Set-Cookie, Age, ETag}.
#
#   Plus adversarial probes against /control/bundle.json:
#     * malformed Authorization header (NUL byte)
#     * 16KB-long bearer token
#     * no Host header (--http1.0 -H "Host:" to suppress)
#     * HEAD vs GET (informational only — many cover sites differ here)
#
# Exit codes:
#   0 — all probes match the baseline
#   1 — fingerprint mismatch (cover disguise broken)
#   2 — non-deterministic baseline (skipped, NOT a failure but worth flagging)
#

set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

STRICT=false
SINGLE_URL=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --strict) STRICT=true; shift ;;
        http*)    SINGLE_URL="$1"; shift ;;
        -h|--help) sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown arg: $1" >&2; exit 1 ;;
    esac
done

# Normalization: strip volatile body content + the request path out of
# the response so a cover-site 404 that echoes the URL doesn't compare
# unequal across two different probe URLs. Also collapse whitespace so
# pretty-printed vs. compact HTML doesn't matter.
normalize_body() {
    local path="${1:-}"
    # Escape regex specials in path so sed treats it literally. Path
    # is always a `/some/thing` shape, so the only specials we need
    # to worry about are `.` and `/` — but escaping all metacharacters
    # makes future paths safe too.
    local escaped_path
    escaped_path=$(printf '%s\n' "$path" | sed -E 's/[][\\\/.^$*+?(){}|]/\\&/g')
    sed -E \
        -e "s|${escaped_path}|<PATH>|g" \
        -e 's/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[Z+0-9:.-]*/<NORM>/g' \
        -e 's/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/<NORM>/g' \
        -e 's/[[:space:]]+/ /g'
}

# Strip volatile headers, normalize whitespace, lowercase header names
# (HTTP headers are case-insensitive) so an upstream that emits
# `content-type` vs `Content-Type` doesn't fingerprint.
#
# Implementation note: `sed 's/.../\L\1/'` would be the obvious one-liner
# for lowercasing, but `\L` is a GNU sed extension — macOS / BSD sed
# emit a literal `L` character instead. awk's tolower() is POSIX and
# works everywhere. Operators with brew's gnu-sed on PATH would have
# the GNU form silently work and not notice the breakage on a fresh
# CI box or a different cover host.
strip_volatile_headers() {
    awk -F: '
        # Lowercase the header name (everything before the first colon)
        # and preserve the value verbatim. Lines without a colon
        # (HTTP/2 status line) pass through unchanged.
        /^[A-Za-z-]+:/ {
            name = tolower($1)
            value_pos = index($0, ":")
            rest = substr($0, value_pos + 1)
            print name ":" rest
            next
        }
        { print }
    ' \
        | grep -v -i -E '^(date|server-timing|x-request-id|x-trace-id|set-cookie|age|etag):' \
        | awk '{ gsub(/[[:space:]]+/, " "); print }' \
        | sort
}

# Probe a URL once. Echoes pipe-delimited:
#   STATUS|CONTENT_TYPE|CONTENT_LENGTH|HEADER_SHA|BODY_SHA|CURL_RC
# CURL_RC = curl's exit code (0 = OK; 6 = DNS; 7 = connect-fail; 28 =
# timeout; 35 = TLS handshake; etc). The caller MUST treat CURL_RC != 0
# as "this URL wasn't actually reached" — comparing two synthetic
# 000|?|0|<empty-sha>|<empty-sha> probes against each other is a false
# PASS (the test would learn nothing).
probe_once() {
    local url="$1"
    local path="$2"
    local extra_args=("${@:3}")
    local resp_file headers_file
    resp_file=$(mktemp)
    headers_file=$(mktemp)

    curl -sS --max-time 10 \
         -D "$headers_file" -o "$resp_file" \
         "${extra_args[@]}" \
         "$url" >/dev/null 2>&1
    local curl_rc=$?

    local status content_type content_length header_sha body_sha
    status=$(head -1 "$headers_file" | awk '{print $2}')
    content_type=$(grep -i '^Content-Type:' "$headers_file" | head -1 | sed -E 's/^[^:]+:[[:space:]]*//' | tr -d '\r')
    content_length=$(wc -c < "$resp_file" | tr -d ' ')
    header_sha=$(strip_volatile_headers < "$headers_file" | shasum -a 256 | awk '{print $1}')
    body_sha=$(normalize_body "$path" < "$resp_file" | shasum -a 256 | awk '{print $1}')

    rm -f "$resp_file" "$headers_file"
    echo "${status:-000}|${content_type:-?}|${content_length}|${header_sha}|${body_sha}|${curl_rc}"
}

# Test a single endpoint
test_endpoint() {
    local label="$1"
    local url="$2"
    local base_url path random_path random_url
    base_url=$(echo "$url" | sed -E 's|(https?://[^/]+).*|\1|')
    path=$(echo "$url" | sed -E 's|https?://[^/]+||')
    random_path="/_bbtest_$(openssl rand -hex 8)"
    random_url="${base_url}${random_path}"

    echo ""
    echo "=== $label ($base_url) ==="
    echo "  bundle path:  $path"
    echo "  random path:  $random_path"

    # 1. Baseline determinism — 5 GETs to the random path
    echo "  baseline determinism (5 GETs)..."
    local baseline_probes=()
    local i
    for i in 1 2 3 4 5; do
        baseline_probes+=("$(probe_once "$random_url" "$random_path")")
    done

    local first="${baseline_probes[0]}"
    local baseline_status baseline_ct baseline_cl baseline_hsha baseline_bsha baseline_rc
    IFS='|' read -r baseline_status baseline_ct baseline_cl baseline_hsha baseline_bsha baseline_rc <<< "$first"

    # Curl-failed baseline (DNS / TCP / TLS / timeout) cannot tell us
    # ANYTHING about disguise. Earlier versions would let 000|?|0|<empty>
    # probes match each other and report PASS — a false greenlight.
    # Refuse to proceed.
    if [[ "$baseline_status" == "000" || "$baseline_rc" -ne 0 ]]; then
        echo -e "  ${RED}FAIL: baseline GET was inconclusive (status=$baseline_status curl_rc=$baseline_rc)${NC}"
        echo "    The endpoint is unreachable or TLS-failing; nothing to compare. Re-run after the cover site is healthy."
        return 1
    fi

    # Are all 5 baseline probes identical?
    local determ=true
    for p in "${baseline_probes[@]}"; do
        if [[ "$p" != "$first" ]]; then
            determ=false
            break
        fi
    done

    if [[ "$determ" != true ]]; then
        echo -e "  ${YELLOW}SKIP: cover site is non-deterministic (baseline GETs disagree)${NC}"
        echo "    probes:"
        for p in "${baseline_probes[@]}"; do
            echo "      $p"
        done
        return 2
    fi

    echo "  baseline:     status=$baseline_status ct=$baseline_ct cl=$baseline_cl hsha=${baseline_hsha:0:12} bsha=${baseline_bsha:0:12}"

    # 2. Probe /control/bundle.json with no Authorization header
    local target_probe target_status target_ct target_cl target_hsha target_bsha
    target_probe=$(probe_once "$url" "$path")
    IFS='|' read -r target_status target_ct target_cl target_hsha target_bsha _ <<< "$target_probe"
    echo "  no-auth:      status=$target_status ct=$target_ct cl=$target_cl hsha=${target_hsha:0:12} bsha=${target_bsha:0:12}"

    local mismatches=()
    [[ "$target_status" == "$baseline_status" ]] || mismatches+=("status: $target_status vs $baseline_status")
    [[ "$target_ct"     == "$baseline_ct"     ]] || mismatches+=("content-type: '$target_ct' vs '$baseline_ct'")
    [[ "$target_hsha"   == "$baseline_hsha"   ]] || mismatches+=("header-sha differs (volatile-stripped)")

    local cl_diff=$(( target_cl - baseline_cl )); cl_diff=${cl_diff#-}
    if [[ "$STRICT" == true ]]; then
        [[ "$target_cl" == "$baseline_cl" ]] || mismatches+=("content-length: $target_cl vs $baseline_cl (strict)")
    else
        [[ "$cl_diff" -le 32 ]] || mismatches+=("content-length: $target_cl vs $baseline_cl (diff=$cl_diff > 32 tolerance)")
    fi

    [[ "$target_bsha" == "$baseline_bsha" ]] || mismatches+=("normalized body sha differs")

    # 3. Adversarial probes — each one is a (label, curl-arg-array)
    # tuple. case-statement-built arrays rather than `local -n`
    # namerefs because macOS ships bash 3.2 (namerefs need 4.3+). The
    # malformed-auth probe needs to send a literal NUL byte, which
    # requires bash $'...' ANSI-C quoting (the older pipe-delimited
    # tuple format couldn't carry NUL).

    # 16384 'x' chars — bash brace expansion that has to run before
    # the per-probe case so the resulting string is captured.
    local big_token
    big_token=$(printf 'x%.0s' {1..16384})

    local adversarial_labels=("weird-auth-prefix" "oversized-auth" "no-host")
    local n_real_probes=0

    for adv_label in "${adversarial_labels[@]}"; do
        local adv_args
        case "$adv_label" in
            weird-auth-prefix)
                # An attacker might try to coax differing error paths
                # out of upstream-vs-cover by sending a header with
                # unusual characters. We send tab + control bytes
                # (which bash + curl -H DO preserve, unlike NUL bytes
                # which both bash strings and curl's C-string header
                # parser truncate at). Earlier iterations of this
                # script claimed to send a literal NUL — that was
                # wrong: `$'foo\x00bar'` stores only `foo` in bash,
                # and curl's argv-based -H parser also terminates at
                # NUL. To actually carry NUL we'd need openssl
                # s_client with a raw-bytes pipe; out of scope.
                adv_args=(-H $'Authorization: Bearer weird\t\x01\x1f-token')
                ;;
            oversized-auth)
                adv_args=(-H "Authorization: Bearer $big_token")
                ;;
            no-host)
                # Removes the HTTP Host header. Note: SNI is still
                # sent at the TLS layer, so this tests "matched vhost,
                # absent HTTP Host header" — NOT "no vhost match".
                adv_args=(--http1.0 -H "Host:")
                ;;
            *)
                echo -e "${RED}internal error: unknown probe $adv_label${NC}"
                return 1
                ;;
        esac

        # Sample BOTH URLs with the same adversarial probe.
        local adv_target_probe adv_baseline_probe
        adv_target_probe=$(probe_once "$url" "$path" "${adv_args[@]}")
        adv_baseline_probe=$(probe_once "$random_url" "$random_path" "${adv_args[@]}")

        local adv_status adv_ct adv_cl adv_hsha adv_bsha adv_rc
        IFS='|' read -r adv_status adv_ct adv_cl adv_hsha adv_bsha adv_rc <<< "$adv_target_probe"
        local advb_status advb_ct advb_cl advb_hsha advb_bsha advb_rc
        IFS='|' read -r advb_status advb_ct advb_cl advb_hsha advb_bsha advb_rc <<< "$adv_baseline_probe"

        printf "  %-16s target  status=%s rc=%s ct=%s cl=%s hsha=%s bsha=%s\n" \
               "$adv_label:" "$adv_status"  "$adv_rc"  "$adv_ct"  "$adv_cl"  "${adv_hsha:0:12}"  "${adv_bsha:0:12}"
        printf "  %-16s vs base status=%s rc=%s ct=%s cl=%s hsha=%s bsha=%s\n" \
               ""              "$advb_status" "$advb_rc" "$advb_ct" "$advb_cl" "${advb_hsha:0:12}" "${advb_bsha:0:12}"

        # If BOTH probes failed at the TCP/TLS layer (curl_rc != 0, e.g.
        # connection drop on oversized header), the cover site IS
        # indistinguishable under this probe — but the test learned
        # nothing about the disguise. Count only real-HTTP probes
        # toward the "we actually tested it" tally; at least one real
        # probe must succeed for the endpoint to pass.
        if [[ "$adv_rc" -eq 0 && "$advb_rc" -eq 0 ]]; then
            n_real_probes=$((n_real_probes + 1))
        else
            echo -e "    ${YELLOW}note: $adv_label dropped at connection-layer on both URLs (curl_rc=$adv_rc/$advb_rc) — disguise not exercised by this probe${NC}"
        fi

        local adv_cl_diff=$(( adv_cl - advb_cl )); adv_cl_diff=${adv_cl_diff#-}
        if [[ "$adv_status" != "$advb_status" ]]; then
            mismatches+=("$adv_label status differs: $adv_status vs $advb_status")
        fi
        if [[ "$adv_ct" != "$advb_ct" ]]; then
            mismatches+=("$adv_label content-type differs: '$adv_ct' vs '$advb_ct'")
        fi
        if [[ "$adv_hsha" != "$advb_hsha" ]]; then
            mismatches+=("$adv_label header-sha differs (volatile-stripped)")
        fi
        if [[ "$STRICT" == true ]]; then
            [[ "$adv_cl" == "$advb_cl" ]] || mismatches+=("$adv_label content-length: $adv_cl vs $advb_cl (strict)")
        else
            [[ "$adv_cl_diff" -le 32 ]] || mismatches+=("$adv_label content-length: $adv_cl vs $advb_cl (diff=$adv_cl_diff > 32)")
        fi
        [[ "$adv_bsha" == "$advb_bsha" ]] || mismatches+=("$adv_label normalized body sha differs")
    done

    if [[ "$n_real_probes" -eq 0 ]]; then
        echo -e "  ${RED}FAIL: every adversarial probe dropped at the connection layer; no actual HTTP-layer disguise was tested${NC}"
        return 1
    fi

    if [[ ${#mismatches[@]} -gt 0 ]]; then
        echo -e "  ${RED}FAIL: ${#mismatches[@]} mismatch(es):${NC}"
        for m in "${mismatches[@]}"; do
            echo -e "    ${RED}- $m${NC}"
        done
        return 1
    fi

    echo -e "  ${GREEN}PASS: byte-identical (within tolerance)${NC}"
    return 0
}

# --- main ---

OVERALL=0
SKIPPED=0

if [[ -n "$SINGLE_URL" ]]; then
    # `set -eo pipefail` is active, so test_endpoint returning non-zero
    # would abort the script. The naive `|| true` workaround would
    # collapse $? to 0 — both the original `if !` form (which set
    # rc=1 always) and the iter-1 `|| true` form (which set rc=0
    # always) silently greenlit ANY non-zero exit including failures
    # and the documented exit-2 SKIP. The `if/else` form below
    # captures the real rc without changing set-state.
    if test_endpoint "adhoc" "$SINGLE_URL"; then
        rc=0
    else
        rc=$?
    fi
    case "$rc" in
        0) ;;
        2) SKIPPED=1 ;;
        *) OVERALL=1 ;;
    esac
else
    ENDPOINTS_FILE="$PROJECT_DIR/config/control-plane/endpoints.json"
    [[ -f "$ENDPOINTS_FILE" ]] || { echo -e "${RED}missing $ENDPOINTS_FILE${NC}" >&2; exit 1; }

    NUM=$(jq 'length' "$ENDPOINTS_FILE")
    for ((i=0; i<NUM; i++)); do
        label=$(jq -r ".[$i].label" "$ENDPOINTS_FILE")
        url=$(jq -r ".[$i].url" "$ENDPOINTS_FILE")
        placeholder=$(jq -r ".[$i].placeholder // false" "$ENDPOINTS_FILE")
        if [[ "$placeholder" == "true" ]]; then
            echo "skipping $label (placeholder)"
            continue
        fi
        # Same if/else pattern — see commentary on the SINGLE_URL branch above.
        if test_endpoint "$label" "$url"; then
            rc=0
        else
            rc=$?
        fi
        case "$rc" in
            0) ;;
            2) SKIPPED=$((SKIPPED+1)) ;;
            *) OVERALL=1 ;;
        esac
    done
fi

echo ""
if [[ "$OVERALL" -ne 0 ]]; then
    echo -e "${RED}test-cover-fingerprint: at least one endpoint failed the disguise check${NC}"
    exit 1
fi
if [[ "$SKIPPED" -gt 0 ]]; then
    echo -e "${YELLOW}test-cover-fingerprint: $SKIPPED endpoint(s) skipped (non-deterministic baseline)${NC}"
    exit 2
fi
echo -e "${GREEN}test-cover-fingerprint: all endpoints match baseline${NC}"
