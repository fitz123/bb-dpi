# Secrets (generated by deploy.sh)
.env
users.json
servers.json*

# Local/private docs and scripts (not for public repo)
local/
.council/

# Backups
backups/

# Local monitoring (contains server IP)
monitoring/

# Generated client configs (contains user UUIDs)
config/client/generated/

# Control plane real values (cover SNIs, IPs, bearer token) — only
# the .example.json schema is committed; real endpoints live here.
config/control-plane/endpoints.json
config/control-plane/token

# Plans contain architectural detail + threat-model specifics +
# operator-server names. Keep them out of the public-ish repo per the
# wiki PII rules. The one historical plan tracked on main pre-dates
# this rule; new plans go to ~/.claude/projects/.../memory/ or local-only.
docs/plans/

# Web UI build output
ui/

# Editor / external-tool scratch
*.swp
*.bak
*~
.DS_Store
excalidraw.log

# Runtime files
cache.db
vpn.log
.claude/scheduled_tasks.lock

# Go build artifacts (client/bb-vpn binaries) + .pkg staging +
# Phase 5 menu-bar BBVPN.app build output.
build/

# Phase 4 .pkg builder outputs + the unredistributable bundled binaries
# (sing-box, xray) the operator drops in to assemble a release .pkg.
# Versions are pinned via config/control-plane/package-manifest.json;
# operator pulls fresh binaries from the upstream projects per release.
client/pkg-build/dist/
client/pkg-build/payload-binaries/
*.pkg
