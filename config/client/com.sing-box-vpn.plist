<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sing-box-vpn</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/sing-box</string>
        <string>run</string>
        <string>-c</string>
        <string>${HOME}/.config/sing-box/config-auto.json</string>
    </array>
    <key>WorkingDirectory</key>
    <string>${HOME}/.config/sing-box</string>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>${HOME}/.config/sing-box/vpn.log</string>
    <key>StandardErrorPath</key>
    <string>${HOME}/.config/sing-box/vpn.log</string>
</dict>
</plist>
