{
  "dns": {
    "final": "network-dns",
    "rules": [
      {
        "action": "route",
        "domain_suffix": [
          ".example.invalid"
        ],
        "server": "company-dns"
      },
      {
        "action": "evaluate",
        "domain_suffix": [
          ".ru",
          ".su",
          ".xn--p1ai",
          ".yandex.com",
          ".yandex.net",
          ".vk.com",
          ".t.me",
          ".aliyuncs.com",
          ".aliyun.com",
          ".alibabacloud.com"
        ],
        "rule_set": [
          "geosite-category-ru",
          "geosite-cn"
        ],
        "server": "adguard-dns",
        "timeout": "3s"
      },
      {
        "action": "respond",
        "mode": "and",
        "rules": [
          {
            "match_response": true,
            "response_rcode": "NOERROR"
          },
          {
            "invert": true,
            "ip_is_private": true,
            "match_response": true
          },
          {
            "invert": true,
            "ip_cidr": [
              "0.0.0.0/8",
              "100.64.0.0/10",
              "198.18.0.0/15",
              "240.0.0.0/4",
              "::ffff:0:0/96",
              "64:ff9b::/96",
              "2001:db8::/32"
            ],
            "match_response": true
          }
        ],
        "type": "logical"
      },
      {
        "action": "evaluate",
        "server": "google-doh",
        "tag": "g",
        "timeout": "3s"
      },
      {
        "action": "evaluate",
        "server": "cloudflare-doh",
        "tag": "c",
        "timeout": "3s"
      },
      {
        "action": "route",
        "mode": "and",
        "race": true,
        "rules": [
          {
            "match_response": "g",
            "response_rcode": "NOERROR"
          },
          {
            "invert": true,
            "ip_is_private": true,
            "match_response": "g"
          },
          {
            "invert": true,
            "ip_cidr": [
              "0.0.0.0/8",
              "100.64.0.0/10",
              "198.18.0.0/15",
              "240.0.0.0/4",
              "::ffff:0:0/96",
              "64:ff9b::/96",
              "2001:db8::/32"
            ],
            "match_response": "g"
          }
        ],
        "server": "google-doh",
        "type": "logical"
      },
      {
        "action": "route",
        "mode": "and",
        "race": true,
        "rules": [
          {
            "match_response": "c",
            "response_rcode": "NOERROR"
          },
          {
            "invert": true,
            "ip_is_private": true,
            "match_response": "c"
          },
          {
            "invert": true,
            "ip_cidr": [
              "0.0.0.0/8",
              "100.64.0.0/10",
              "198.18.0.0/15",
              "240.0.0.0/4",
              "::ffff:0:0/96",
              "64:ff9b::/96",
              "2001:db8::/32"
            ],
            "match_response": "c"
          }
        ],
        "server": "cloudflare-doh",
        "type": "logical"
      },
      {
        "action": "respond",
        "match_response": "g",
        "race": true,
        "response_rcode": "NXDOMAIN"
      },
      {
        "action": "respond",
        "match_response": "c",
        "race": true,
        "response_rcode": "NXDOMAIN"
      },
      {
        "action": "evaluate",
        "server": "network-dns",
        "tag": "n",
        "timeout": "3s"
      },
      {
        "action": "route",
        "mode": "and",
        "rules": [
          {
            "match_response": "n",
            "response_rcode": "NOERROR"
          },
          {
            "invert": true,
            "ip_is_private": true,
            "match_response": "n"
          },
          {
            "invert": true,
            "ip_cidr": [
              "0.0.0.0/8",
              "100.64.0.0/10",
              "198.18.0.0/15",
              "240.0.0.0/4",
              "::ffff:0:0/96",
              "64:ff9b::/96",
              "2001:db8::/32"
            ],
            "match_response": "n"
          }
        ],
        "server": "network-dns",
        "type": "logical"
      },
      {
        "action": "respond",
        "match_response": "n",
        "response_rcode": "NXDOMAIN"
      },
      {
        "action": "reject"
      }
    ],
    "servers": [
      {
        "detour": "auto",
        "server": "10.0.0.53",
        "tag": "company-dns",
        "type": "udp"
      },
      {
        "domain_resolver": "google-doh",
        "server": "dns.adguard-dns.com",
        "tag": "adguard-dns",
        "type": "https"
      },
      {
        "server": "8.8.8.8",
        "tag": "google-doh",
        "type": "https"
      },
      {
        "server": "1.1.1.1",
        "tag": "cloudflare-doh",
        "type": "https"
      },
      {
        "tag": "network-dns",
        "type": "dhcp"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "ui"
    }
  },
  "http_clients": [
    {
      "tag": "direct-http"
    }
  ],
  "inbounds": [
    {
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "mtu": 1280,
      "route_exclude_address": [
        "alpha.example.invalid/32",
        "beta.example.invalid/32"
      ],
      "stack": "gvisor",
      "strict_route": false,
      "tag": "tun-in",
      "type": "tun"
    }
  ],
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "outbounds": [
    {
      "interrupt_exist_connections": true,
      "interval": "30s",
      "outbounds": [
        "xhttp-alpha",
        "xhttp-beta"
      ],
      "tag": "auto",
      "tolerance": 100,
      "type": "urltest",
      "url": "https://www.gstatic.com/generate_204"
    },
    {
      "connect_timeout": "10s",
      "server": "127.0.0.1",
      "server_port": 1080,
      "tag": "xhttp-alpha",
      "type": "socks"
    },
    {
      "connect_timeout": "10s",
      "server": "127.0.0.1",
      "server_port": 1081,
      "tag": "xhttp-beta",
      "type": "socks"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "block",
      "type": "block"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "google-doh",
    "default_http_client": "direct-http",
    "final": "auto",
    "rule_set": [
